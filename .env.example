LLM_PROXY_SERVER_PORT=8080
LLM_PROXY_SERVER_SHOW_BASE_URL=

LLM_PROXY_LOG_LEVEL=info
LLM_PROXY_LOG_FILE=./logs/proxy.log
LLM_PROXY_LOG_MAX_AGE=30

LLM_PROXY_RATE_LIMIT_ENABLED=true
LLM_PROXY_RATE_LIMIT_DEFAULT_REQUESTS_PER_SECOND=10
LLM_PROXY_RATE_LIMIT_DEFAULT_BURST=20
LLM_PROXY_RATE_LIMIT_WHITELIST=["sk-example-whitelist"]
LLM_PROXY_RATE_LIMIT_OVERRIDES={"sk-example-override":{"requests_per_second":100,"burst":200}}

LLM_PROXY_PROVIDERS_OPENAI_BASE_URL=https://api.openai.com
LLM_PROXY_PROVIDERS_ANTHROPIC_BASE_URL=https://api.anthropic.com

LLM_PROXY_OBSERVABILITY_ENABLED=false
LLM_PROXY_OBSERVABILITY_SERVICE_NAME=llm-proxy
LLM_PROXY_OBSERVABILITY_OTLP_ENDPOINT=http://localhost:4318
LLM_PROXY_OBSERVABILITY_TRACE_SAMPLE_RATIO=0.1
LLM_PROXY_OBSERVABILITY_METRICS_EXPORT_INTERVAL_SECONDS=15

# 统一网关默认关闭；现有透明代理链路不依赖以下配置。
LLM_PROXY_GATEWAY_ENABLED=false
LLM_PROXY_GATEWAY_SNAPSHOT_INTERVAL=5s
LLM_PROXY_GATEWAY_SNAPSHOT_TIMEOUT=3s
LLM_PROXY_GATEWAY_RETRY_BACKOFF=5s
LLM_PROXY_GATEWAY_UPSTREAM_CONNECT_TIMEOUT=10s
LLM_PROXY_GATEWAY_UPSTREAM_TLS_HANDSHAKE_TIMEOUT=10s
LLM_PROXY_GATEWAY_UPSTREAM_RESPONSE_HEADER_TIMEOUT=30s
LLM_PROXY_GATEWAY_UPSTREAM_COMPLETE_TIMEOUT=5m
LLM_PROXY_GATEWAY_UPSTREAM_STREAM_IDLE_TIMEOUT=5m
LLM_PROXY_GATEWAY_UPSTREAM_IDLE_CONNECTION_TIMEOUT=90s
LLM_PROXY_GATEWAY_UPSTREAM_MAX_IDLE_CONNECTIONS=100
LLM_PROXY_GATEWAY_UPSTREAM_MAX_IDLE_CONNECTIONS_PER_HOST=10

LLM_PROXY_DATABASE_DRIVER=postgres
# 连接必须指定 TimeZone=Asia/Shanghai；URL DSN 中可写为 TimeZone=Asia%2FShanghai。
LLM_PROXY_DATABASE_DSN=
LLM_PROXY_DATABASE_MAX_IDLE_CONNECTIONS=5
LLM_PROXY_DATABASE_MAX_OPEN_CONNECTIONS=20
LLM_PROXY_DATABASE_CONNECTION_LIFETIME=30m
LLM_PROXY_DATABASE_CONNECT_TIMEOUT=3s

# 统一网关启用时至少 24 个字符；生产环境请使用随机值。
LLM_PROXY_CONTROL_PLANE_TOKEN=

# KEYS 使用 JSON：版本号映射到 Base64 编码的 32 字节主密钥。
# 示例结构（请勿照抄为生产密钥）：{"v1":"<base64-encoded-32-byte-key>"}
LLM_PROXY_CREDENTIAL_ENCRYPTION_CURRENT_KEY_VERSION=
LLM_PROXY_CREDENTIAL_ENCRYPTION_KEYS={}
